# Clerk authentication: publishable key is safe for Vite/browser use.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Supabase browser client. Enable Row Level Security on all exposed tables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secrets. Never prefix these with VITE_ or expose them to browsers.
# This Vite app currently has no server runtime; these are for a future trusted backend.
CLERK_SECRET_KEY=sk_test_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
