ifies university emails with approved domains', () => {\n      expect(checkCampusVerification('student@stanford.edu').isVerified).toBe(true);\n      expect(checkCampusVerification('researcher@mit.edu').isVerified).toBe(true);\n      expect(checkCampusVerification('random@gmail.com').isVerified).toBe(false);\n      expect(checkCampusVerification('test@yahoo.com').isVerified).toBe(false);\n    });\n  });\n\n  describe('Module 1: Skill & Portfolio Service', () => {\n    it('adds and manages student skills with proficiency', async () => {\n      const alex = await prisma.user.findUnique({ where: { email: 'alex@stanford.edu' } });\n      expect(alex).toBeDefined();\n\n      const studentSkill = await addStudentSkill(alex!.id, 'Next.js', 'Web Development', 'EXPERT');\n      expect(studentSkill).toBeDefined();\n      expect(studentSkill.proficiency).toBe('EXPERT');\n\n      const profile = await getPublicFreelancerProfile(alex!.id);\n      expect(profile).toBeDefined();\n      expect(profile?.skills.some((s) => s.skill.name === 'Next.js')).toBe(true);\n    });\n\n    it('adds portfolio projects with technology tags and links', async () => {\n      const alex = await prisma.user.findUnique({ where: { email: 'alex@stanford.edu' } });\n      const portfolio = await addPortfolioItem(alex!.id, {\n        title: 'Automated Campus Shuttle Booking',\n        description: 'Real-time seat reservation system for late night campus rides.',\n        technologies: 'Next.js, Tailwind CSS, TypeScript',\n        projectUrl: 'https://shuttle.campuscraft.test',\n      });\n\n      expect(portfolio.id).toBeDefined();\n      expect(portfolio.title).toBe('Automated Campus Shuttle Booking');\n    });\n  });\n\n  describe('Module 2: Gig & Matching Service', () => {\n    let testGigId = '';\n\n    it('creates a gig with required skills and budgets', async () => {\n      const sarah = await prisma.user.findUnique({ where: { email: 'sarah@stanford.edu' } });\n      const gig = await createGig(sarah!.id, {\n        title: 'Automated Event Ticketing Scanner App',\n        description: 'React Native app to scan QR codes for campus concerts with offline caching.',\n        category: 'App Development',\n        budgetType: 'FIXED',\n        minBudget: 3000,\n        maxBudget: 4500,\n        deadline: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString(),\n        estimatedDuration: '14 days',\n        experienceRequirement: 'EXPERT',\n        freelancersNeeded: 1,\n        skillNames: ['React Native', 'TypeScript', 'Flutter'],\n      });\n\n      expect(gig).toBeDefined();\n      expect(gig?.title).toBe('Automated Event Ticketing Scanner App');\n      expect(gig?.skills.length).toBe(3);\n      testGigId = gig!.id;\n    });\n\n    it('executes Talent Matching Engine with the exact 70/20/10 weighted formula', async () => {\n      // Test the demonstration gig \"Build a College Event Website\"\n      const gig = await prisma.gig.findFirst({\n        where: { title: 'Build a College Event Website' },\n      });\n      expect(gig).toBeDefined();\n\n      const recommendations = await matchTalentForGig(gig!.id);\n      expect(recommendations.length).toBeGreaterThan(0);\n\n      // Alex Chen has HTML, CSS, JavaScript, React (100% skill match), AVAILABLE (100% avail), INTERMEDIATE (100% exp)\n      // Score = 0.7*100 + 0.2*100 + 0.1*100 = 100\n      const alexMatch = recommendations.find((r) => r.studentName === 'Alex Chen');\n      expect(alexMatch).toBeDefined();\n      expect(alexMatch?.finalScore).toBe(100);\n      expect(alexMatch?.matchedSkills).toContain('React');\n      expect(alexMatch?.matchedSkills).toContain('JavaScript');\n      expect(alexMatch?.matchedSkills).toContain('HTML');\n      expect(alexMatch?.matchedSkills).toContain('CSS');\n      expect(alexMatch?.missingSkills.length).toBe(0);\n    });\n\n    it('filters gigs by keyword, category, and budget', async () => {\n      const webGigs = await listGigs({ category: 'Web Development', status: 'ALL' });\n      expect(webGigs.length).toBeGreaterThan(0);\n      expect(webGigs.every((g) => g.category === 'Web Development')).toBe(true);\n\n      const searchedGigs = await listGigs({ search: 'Event', status: 'ALL' });\n      expect(searchedGigs.length).toBeGreaterThan(0);\n    });\n  });\n\n  describe('Module 3: Work Agreement, Milestones, Delivery & Review Workflow', () => {\n    let newGigId = '';\n    let newProposalId = '';\n    let newProjectId = '';\n    let alexId = '';\n    let sarahId = '';\n\n    beforeAll(async () => {\n      const alex = await prisma.user.findUnique({ where: { email: 'alex@stanford.edu' } });\n      const sarah = await prisma.user.findUnique({ where: { email: 'sarah@stanford.edu' } });\n      alexId = alex!.id;\n      sarahId = sarah!.id;\n\n      // Create a fresh gig for end-to-end acceptance test\n      const gig = await createGig(sarahId, {\n        title: 'Design Campus Hackathon Badge Icons',\n        description: 'Need SVG badge icons for our annual campus hackathon winners.',\n        category: 'Graphic Design',\n        minBudget: 1200,\n        maxBudget: 1800,\n        deadline: new Date(Date.now() + 5 * 24 * 60 * 60 * 1000).toISOString(),\n        skillNames: ['HTML', 'CSS'],\n      });\n      newGigId = gig!.id;\n    });\n\n    it('submits a proposal and prevents duplicate active proposals', async () => {\n      const proposal = await submitProposal(alexId, {\n        gigId: newGigId,\n        coverMessage: 'I have extensive experience creating SVG vector graphics and badges for student groups.',\n        proposedPrice: 1500,\n        estimatedDays: 3,\n      });\n\n      expect(proposal.id).toBeDefined();\n      expect(proposal.status).toBe('PENDING');\n      newProposalId = proposal.id;\n\n      // Duplicate submission attempt must throw\n      await expect(\n        submitProposal(alexId, {\n          gigId: newGigId,\n          coverMessage: 'Second duplicate proposal attempt',\n          proposedPrice: 1500,\n          estimatedDays: 3,\n        })\n      ).rejects.toThrow('already submitted an active proposal');\n    });\n\n    it('accepts proposal, creates work agreement, payment record, and milestones', async () => {\n      const project = await acceptProposal(newProposalId, sarahId);\n      expect(project.id).toBeDefined();\n      expect(project.status).toBe('ACTIVE');\n      expect(project.agreedBudget).toBe(1500);\n      newProjectId = project.id;\n\n      // Verify work agreement\n      const agreement = await prisma.workAgreement.findUnique({ where: { projectId: newProjectId } });\n      expect(agreement).toBeDefined();\n      expect(agreement?.status).toBe('ACTIVE');\n\n      // Verify milestones created\n      const milestones = await prisma.milestone.findMany({ where: { projectId: newProjectId } });\n      expect(milestones.length).toBe(3);\n    });\n\n    it('submits delivery and reviews with approval', async () => {\n      const milestone = await prisma.milestone.findFirst({ where: { projectId: newProjectId } });\n      expect(milestone).toBeDefined();\n\n      const delivery = await submitDelivery(alexId, {\n        projectId: newProjectId,\n        milestoneId: milestone!.id,\n        description: 'Completed preliminary draft of the badge icons in high resolution SVG.',\n        fileUrl: 'https://campuscraft.test/deliverables/badges-v1.zip',\n        fileName: 'badges-v1.zip',\n      });\n      expect(delivery.status).toBe('SUBMITTED');\n\n      // Client reviews and approves delivery\n      const approvedDelivery = await reviewDelivery(delivery.id, sarahId, 'APPROVED', 'Looks fantastic!');\n      expect(approvedDelivery.status).toBe('APPROVED');\n    });\n\n    it('submits 5-star review and updates student profile stats', async () => {\n      const initialProfile = await prisma.studentProfile.findUnique({ where: { userId: alexId } });\n      const initialTotalReviews = initialProfile?.totalReviews || 0;\n\n      const review = await submitReview(sarahId, {\n        projectId: newProjectId,\n        rating: 5,\n        comment: 'Outstanding quality and very fast turnaround time!',\n      });\n\n      expect(review.rating).toBe(5);\n\n      // Verify profile stats updated\n      const updatedProfile = await prisma.studentProfile.findUnique({ where: { userId: alexId } });\n      expect(updatedProfile?.totalReviews).toBe(initialTotalReviews + 1);\n      expect(updatedProfile?.averageRating).toBeGreaterThanOrEqual(4.8);\n\n      // Duplicate review attempt must be rejected\n      await expect(\n        submitReview(sarahId, {\n          projectId: newProjectId,\n          rating: 4,\n          comment: 'Duplicate review should be blocked',\n        })\n      ).rejects.toThrow('already submitted a review');\n    });\n  });\n});\n"],"file":"/tests/marketplace.test.ts"}