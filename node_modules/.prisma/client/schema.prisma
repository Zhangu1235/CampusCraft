datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------
// News items scraped from Lovely Professional University
// -------------------------------------------------
model NewsItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  link        String
  postedAt    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([link])
}

// -------------------------------------------------
// Existing application models (unchanged)
// -------------------------------------------------
model User {
  id                 String   @id @default(uuid())
  clerkId            String?  @unique
  email              String   @unique
  name               String
  role               String   @default("STUDENT") // STUDENT, CLIENT, ADMIN
  activeRole         String   @default("STUDENT") // STUDENT, CLIENT
  avatarUrl          String?
  university         String?
  department         String?
  semester           String?
  registrationNumber String?  @unique // LPU Registration Number (Private, Unique)
  academicYear       String? // 1st Year, 2nd Year, 3rd Year, 4th Year
  verificationStatus String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  isCampusVerified   Boolean  @default(false)
  verifiedDomain     String?
  status             String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  studentProfile     StudentProfile?
  verifications      StudentVerification[]
  adminActions       AdminAction[]         @relation("AdminUserActions")
  adminTargetActions AdminAction[]         @relation("TargetUserActions")
  gigs               Gig[]                 @relation("ClientGigs")
  proposals          Proposal[]            @relation("StudentProposals")
  projectsAsClient   Project[]             @relation("ClientProjects")
  projectsAsStudent  Project[]             @relation("StudentProjects")
  reviewsGiven       Review[]              @relation("ReviewsGiven")
  reviewsReceived    Review[]              @relation("ReviewsReceived")
  notifications      Notification[]
  sentMessages       Message[]             @relation("SentMessages")
  receivedMessages   Message[]             @relation("ReceivedMessages")
  reportsMade        Report[]              @relation("ReportsMade")
  reportsAgainst     Report[]              @relation("ReportsAgainst")
  deliveries         Delivery[]
}

model StudentProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  bio                    String?
  location               String?
  contactPreference      String?  @default("EMAIL")
  availability           String   @default("AVAILABLE") // AVAILABLE, BUSY, UNAVAILABLE
  experienceLevel        String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  preferredWorkType      String?  @default("REMOTE") // REMOTE, HYBRID, ON_CAMPUS
  hourlyRate             Float?
  githubUrl              String?
  linkedinUrl            String?
  portfolioWebsite       String?
  completedProjectsCount Int      @default(0)
  averageRating          Float    @default(0.0)
  totalReviews           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  skills         StudentSkill[]
  portfolioItems Portfolio[]
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())

  studentSkills StudentSkill[]
  gigSkills     GigSkill[]
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skillId          String
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency      String         @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  createdAt        DateTime       @default(now())

  @@unique([studentProfileId, skillId])
}

model Portfolio {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  imageUrl         String?
  technologies     String // Comma-separated or JSON
  projectUrl       String?
  githubUrl        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Gig {
  id                     String   @id @default(uuid())
  clientId               String
  client                 User     @relation("ClientGigs", fields: [clientId], references: [id], onDelete: Cascade)
  title                  String
  description            String
  category               String
  budgetType             String   @default("FIXED") // FIXED, HOURLY
  minBudget              Float
  maxBudget              Float
  deadline               DateTime
  estimatedDuration      String?
  experienceRequirement  String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  freelancersNeeded      Int      @default(1)
  additionalInstructions String?
  attachmentUrl          String?
  status                 String   @default("OPEN") // DRAFT, OPEN, PAUSED, ASSIGNED, COMPLETED, CANCELLED
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  skills    GigSkill[]
  proposals Proposal[]
  projects  Project[]
  reports   Report[]
}

model GigSkill {
  id      String @id @default(uuid())
  gigId   String
  gig     Gig    @relation(fields: [gigId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([gigId, skillId])
}

model Proposal {
  id                 String   @id @default(uuid())
  gigId              String
  gig                Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  studentId          String
  student            User     @relation("StudentProposals", fields: [studentId], references: [id], onDelete: Cascade)
  coverMessage       String
  proposedPrice      Float
  estimatedDays      Int
  relevantExperience String?
  portfolioReference String?
  attachmentUrl      String?
  status             String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, WITHDRAWN
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project Project?

  @@unique([gigId, studentId])
}

model Project {
  id           String   @id @default(uuid())
  gigId        String
  gig          Gig      @relation(fields: [gigId], references: [id], onDelete: Restrict)
  proposalId   String   @unique
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  clientId     String
  client       User     @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  studentId    String
  student      User     @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Restrict)
  title        String
  description  String
  agreedBudget Float
  deadline     DateTime
  status       String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agreement     WorkAgreement?
  milestones    Milestone[]
  deliveries    Delivery[]
  reviews       Review[]
  paymentRecord PaymentRecord?
}

model WorkAgreement {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopeOfWork      String
  agreedBudget     Float
  expectedDeadline DateTime
  status           String   @default("ACTIVE") // PENDING, ACCEPTED, ACTIVE, COMPLETED, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime
  amount      Float
  orderIndex  Int      @default(1)
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, SUBMITTED, APPROVED, REVISION_REQUESTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deliveries Delivery[]
}

model Delivery {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  studentId   String
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description String
  fileUrl     String
  fileName    String?
  fileSize    Int?
  status      String     @default("SUBMITTED") // SUBMITTED, APPROVED, REVISION_REQUESTED
  feedback    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  rating       Int // 1 to 5
  comment      String
  createdAt    DateTime @default(now())

  @@unique([projectId, reviewerId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Conversation {
  id             String   @id @default(uuid())
  gigId          String?
  projectId      String?
  participant1Id String
  participant2Id String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  messages Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String
  receiver       User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Report {
  id           String   @id @default(uuid())
  reporterId   String
  reporter     User     @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?    @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: SetNull)
  gigId        String?
  gig          Gig?     @relation(fields: [gigId], references: [id], onDelete: SetNull)
  reason       String
  details      String?
  status       String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  createdAt    DateTime @default(now())
}

model PaymentRecord {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount    Float
  status    String   @default("PENDING") // NOT_REQUIRED, PENDING, PAID, REFUNDED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAction {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation("AdminUserActions", fields: [adminId], references: [id], onDelete: Cascade)
  actionType   String // VERIFY_STUDENT_APPROVE, VERIFY_STUDENT_REJECT, SUSPEND_USER, ACTIVATE_USER, RESOLVE_REPORT
  targetUserId String?
  targetUser   User?    @relation("TargetUserActions", fields: [targetUserId], references: [id], onDelete: SetNull)
  details      String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
}

model StudentVerification {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrationNumber String
  department         String
  academicYear       String
  idCardPath         String // Secure private storage path (never public)
  idCardFileName     String?
  status             String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([registrationNumber])
}
